  "news_highlights": [
    {
      "title": "Backdoor in Claude Code for VS Code extension on the Cursor Marketplace",
      "url": "https://phorion.io/blog/offical-claude-code-vsx-compromise/",
      "why_it_matters": "Versions 2.1.312 and 2.1.313 of the Claude Code extension on the Cursor Marketplace planted an SSH key, a reverse tunnel and a fake com.apple.sysmond LaunchAgent on macOS. If you use Cursor, check your extension version, ~/.ssh/authorized_keys and ~/Library/LaunchAgents. Top AI thread on HN today (786 points)."
    },
    {
      "title": "AI isn't replacing SREs, it's deskilling them",
      "url": "https://newsletter.signoz.io/p/ai-isnt-replacing-sres-its-deskilling",
      "why_it_matters": "Uses the 1983 'Ironies of Automation' paper to argue that letting AI handle routine incidents erodes the skills you need for rare novel ones. The same applies to leaning on coding agents for all your debugging (512 points on HN)."
    },
    {
      "title": "Show HN: A working Nintendo in ~1GB of Qwen weights",
      "url": "https://github.com/dbreunig/nesformer",
      "why_it_matters": "Drew Breunig used two short Opus prompts to bake an NES 6502 CPU emulator into Qwen3.5-4B weights. It's a good example of how far an agent can take a loose idea when it has a conformance test suite to check against."
    },
    {
      "title": "Cisco gives engineer unlimited AI tokens to rewrite legacy code",
      "url": "https://fortune.com/2026/10/30/cisco-president-jeetu-patel-gen-z-27-year-old-unlimited-ai-tokens-rewrite-legacy-code-entry-level-jobs/",
      "why_it_matters": "Big companies are starting to point coding agents at legacy rewrites, which is a growing kind of work for developers who know agent tooling well."
